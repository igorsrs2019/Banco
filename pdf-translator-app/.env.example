# Copie este arquivo para .env e preencha com suas credenciais
# A chave EXPO_PUBLIC_ é necessária para que o Expo SDK exponha a variável no bundle

# Obrigatório: chave da API OpenAI (ou qualquer API compatível)
EXPO_PUBLIC_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: URL base da API (padrão: OpenAI)
# Use esta variável para trocar por outro provedor (ex: OpenRouter, Together AI, etc.)
EXPO_PUBLIC_AI_BASE_URL=https://api.openai.com/v1

# Opcional: modelo a usar (padrão: gpt-4o-mini)
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
